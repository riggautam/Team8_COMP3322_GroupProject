MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=west
MYSQL_USER=west
MYSQL_PASSWORD=change-me
GOOGLE_MAPS_API_KEY=change-me

VITE_GOOGLE_MAPS_API_KEY=change-me
OPENROUTER_API_KEY=change-me

# Local development defaults. For HTTPS production, use backend-prod, frontend-prod,
# set both frontend ports to 443, and point CERTS_DIR at the server certificate directory.
BACKEND_TARGET=backend-dev
FRONTEND_TARGET=frontend-dev
FRONTEND_HOST_PORT=8080
FRONTEND_CONTAINER_PORT=5173
CERTS_DIR=./certs
# Required: at least 32 random characters, e.g. from `openssl rand -hex 32`.
# The backend refuses to start while this is missing, too short or still the example value.
SESSION_SECRET=replace-with-a-long-random-string

GOOGLE_CLIENT_ID=change-me.apps.googleusercontent.com 
GOOGLE_CLIENT_SECRET=change-me
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# Required. The first admin account, created when the backend starts if it doesn't exist yet
# (an existing account with this email is made admin instead, keeping its password).
# The backend refuses to start while these are missing or still the example values.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-password
